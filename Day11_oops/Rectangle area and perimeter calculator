class Rectangle:
    def __init__(self,length,width):
        self.length = length
        self.width = width

    def Area(self):
        print("Rectangle length :",self.length)
        print("Rectangle width :",self.width)
        return self.length * self.width

    def perimeter(self):
        print("Rectangle length :",self.length)
        print("Rectangle width :",self.width)
        return 2 * (self.length + self.width)

