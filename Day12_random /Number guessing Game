# Number guessing Game by use of ramdom
import random as rd

num = rd.randint(1,10)

print("=== Number guessing Game ===")

attempts = 3
while attempts>0:
    user_choice = int(input("Enter you choice(1-10): "))

    if user_choice == num:
       print("--- You win!---")
       break
    elif user_choice > num:
        print("Too high...")
    elif user_choice < num:
        print("Too low...")

    attempts -=1
    print(f"attempts remains {attempts}")
else:
    print("you loss 😔")
    
print(f"The number is {num}")
    
